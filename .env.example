# SmartPark Docker Environment Template
# Copy file này thành .env và điền giá trị thật trước khi deploy

# PostgreSQL
POSTGRES_PASSWORD=smartpark2026_change_me

# Redis
REDIS_PASSWORD=smartpark_redis_2026_change_me

# JWT Secret (tối thiểu 64 ký tự ngẫu nhiên)
JWT_SECRET=change_this_to_a_random_64_char_string_in_production

# Client URL (URL frontend sau khi deploy)
CLIENT_URL=http://localhost:80

# VITE API URL (URL backend từ phía browser)
VITE_API_URL=http://localhost:5000

# Gmail SMTP (để gửi OTP)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here

# Admin Security PIN (6 chữ số, thay đổi bắt buộc)
ADMIN_SECURITY_PIN=000000
